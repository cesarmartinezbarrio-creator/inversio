# Copia este fichero como referencia de las variables que hay que crear
# en Vercel (Project Settings -> Environment Variables). NUNCA subas un
# fichero .env con valores reales al repositorio.

# La contraseña de acceso a la app. Invéntate algo largo y aleatorio,
# no una palabra del diccionario. La misma cadena hay que pegarla luego
# en la app la primera vez que la abras.
APP_TOKEN=

# Clave gratuita de https://twelvedata.com (Dashboard -> API Keys)
TWELVE_DATA_KEY=

# Clave gratuita de https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Del proyecto de Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# OJO: la "service_role key", NUNCA la "anon public key" (esta función
# tiene que poder escribir sin que existan políticas RLS abiertas).
SUPABASE_SERVICE_KEY=

# El dominio exacto donde vive el frontend en Hostinger (con https://,
# sin barra final). Solo ese origen podrá llamar a esta API.
ALLOWED_ORIGIN=https://tudominio.com
